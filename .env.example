# Renombrar este archivo a .env y completar con tus datos reales

# ── PostgreSQL ────────────────────────────────────────────
# En LOCAL usa estas variables sueltas:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=paranormal_db
DB_USER=tu_usuario
DB_PASSWORD=tu_password

# En RAILWAY no uses las DB_* de arriba: Railway inyecta una sola
# variable DATABASE_URL (referenciándola desde el plugin de Postgres).
# El código la detecta y la prioriza automáticamente.
# DATABASE_URL=postgresql://user:pass@host:port/dbname

# ── Flask ─────────────────────────────────────────────────
SECRET_KEY=cambia_esto_por_una_clave_secreta_larga
MAX_CONTENT_MB=50

# Poner en 0 en producción (Railway) para desactivar el modo debug.
FLASK_DEBUG=1

# ── Almacenamiento de archivos ────────────────────────────
# Carpeta donde se guardan los uploads. En local se puede dejar vacío
# (usa ./uploads). En Railway apúntala al mount de un Volume persistente,
# p. ej. /data, para que los archivos NO se borren en cada redeploy.
# UPLOADS_DIR=/data
